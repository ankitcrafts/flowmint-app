# ═══════════════════════════════════════════════════════════════
# FlowMint — Environment Variables Template
# ═══════════════════════════════════════════════════════════════
#
# Copy this file to .env.local and fill in your real values:
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real keys.
# ═══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Google Auth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── JWT (CRITICAL — server will NOT start without this) ───────
# MUST be a cryptographically random key (minimum 64 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# In production, this should be a DIFFERENT key from your Supabase JWT Secret.
# The server validates both Express-signed tokens AND Supabase tokens independently.
JWT_SECRET=generate-a-random-128-char-hex-string-see-command-above

# Optional: Set this when rotating JWT_SECRET to avoid downtime.
# When you change JWT_SECRET, put the OLD value here temporarily.
# Remove after all old tokens have expired (15 min for access, 7 days for refresh).
# JWT_SECRET_PREVIOUS=old-secret-during-rotation-only

# ── AI Providers ───────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_API_KEY=your-gemini-api-key

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
