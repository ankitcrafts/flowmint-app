# ═══════════════════════════════════════════════════════════════
# FlowMint — Environment Variables Template
# ═══════════════════════════════════════════════════════════════
#
# Copy this file to .env.local and fill in your real values:
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real keys.
# ═══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Backend email OTP delivery (required for email sign-in) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-provider-app-password
SMTP_FROM="FlowMint <your-sender@gmail.com>"
# Optional; defaults to SUPABASE_SERVICE_ROLE_KEY when unset.
# OTP_HASH_SECRET=use-a-long-random-server-only-secret

# ── Legacy Google client IDs (V1 Google OAuth is configured in Supabase) ──
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Legacy Express JWT settings (not required by V1 auth) ─────
# JWT_SECRET=legacy-express-jwt-secret
# JWT_SECRET_PREVIOUS=old-secret-during-rotation-only

# ── Legacy credit integration; not required by V1 ─────────────
# APIFY_API_TOKEN=your-apify-api-token

# ── AI Providers (backend only; never add VITE_ prefixes) ─────
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
